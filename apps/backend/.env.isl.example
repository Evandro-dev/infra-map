# Copie somente estas variáveis para apps/backend/.env EXISTENTE.
# Não apague DATABASE_URL, API_PORT, CORS_ORIGIN, nem segredos já configurados.
# hosted = nuvem ISL; self-hosted = servidor próprio; disabled = sem integração.
ISL_MODE=disabled
# Obrigatório somente com ISL_MODE=self-hosted. URL HTTPS do ISL Conference Proxy.
ISL_SERVER_URL=
# Idealmente use uma conta técnica com permissões mínimas autorizadas.
ISL_API_USERNAME=
ISL_API_PASSWORD=
# Executa ISL Light no MESMO Windows onde o backend local está rodando.
ISL_LIGHT_EXE=
# Configure um valor aleatório de pelo menos 32 caracteres (gerado no atualizador).
SUPPORT_OPERATOR_TOKEN=
# CREDENTIALS_ENCRYPTION_KEY é gerada por npm run setup; preserve-a em backup seguro.
# O modo de execução remota fica BLOQUEADO até validação e aprovação de TI.
ISL_REMOTE_EXEC_ENABLED=false
